{
  "name": "@appiary/e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm run test:mocked && npm run test:real",
    "test:mocked": "playwright test --project=chromium --grep-invert @real-api",
    "test:real": "playwright test --project=chromium --grep @real-api --workers=1",
    "test:browser-smoke": "playwright test --project=firefox-desktop --project=webkit-desktop --project=pixel-7 --grep @browser-smoke --grep-invert @real-api",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --project=chromium --ui",
    "install:browsers": "playwright install",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.54.0",
    "@types/pg": "^8.15.1",
    "dotenv": "^16.5.0",
    "pg": "^8.16.0",
    "typescript": "^5.8.3"
  }
}
